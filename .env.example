# MindLedger Environment Configuration Template

# Server Settings
APP_HOST=127.0.0.1
APP_PORT=8787
LOG_LEVEL=INFO

# Database Settings
DATABASE_PATH=mindledger.db

# Tracking Settings
POLL_INTERVAL_SECONDS=2
IDLE_THRESHOLD_SECONDS=300

# SMTP / Email Reports Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=user@gmail.com
SMTP_PASSWORD=your_app_password
REPORT_RECIPIENT_EMAIL=user@gmail.com
